# ───────────────────────────────────────────────
# CONFIGURACIÓN DE ENTORNO — LDL-UNSADA-TPI
# ───────────────────────────────────────────────

# --- Entorno ---
# development | production | testing
APP_ENV=development
# true muestra errores detallados; false los oculta
APP_DEBUG=true

# --- Base de Datos ---
# Driver PDO (pdo_mysql, pdo_pgsql, etc.)
DB_DRIVER=pdo_mysql
# Host del servidor de base de datos
DB_HOST=localhost
# Puerto de conexión
DB_PORT=3306
# Nombre de la base de datos
DB_NAME=defaultdb
# Usuario de base de datos
DB_USER=root
# Contraseña del usuario
DB_PASS=
# Juego de caracteres
DB_CHARSET=utf8mb4
# SSL: REQUIRED | PREFERRED | NONE
DB_SSL=REQUIRED

# --- JWT ---
# Clave secreta para firmar los tokens JWT. CAMBIAR en producción.
# Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-this-to-a-random-secret-key
# Duración del token en segundos (3600 = 1 hora, 900 = 15 min)
JWT_EXPIRY=3600

# --- CORS ---
# Origen permitido para CORS (Access-Control-Allow-Origin).
# "*" permite cualquier origen (útil en desarrollo).
# En producción, especificar el dominio exacto:
#   CORS_ORIGIN=https://app.midominio.com
# Déjalo vacío o comentalo para usar "*" por defecto.
CORS_ORIGIN=*

# --- Email / SMTP (Recuperación de contraseña) ---
# Activar cuando el cliente provea las credenciales SMTP.
# Hasta entonces, MAIL_ENABLED=false y el sistema mostrará un mensaje de error al usuario.
#
# Proveedores comunes:
#   Gmail personal → MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
#                    Requiere "App Password" de Google:
#                    Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
#   Brevo (ex Sendinblue) → MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
#   SendGrid → MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587, MAIL_ENCRYPTION=tls
#
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=tu_cuenta@gmail.com
MAIL_FROM_NAME=ICB Digital
