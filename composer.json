{
    "name": "scarc/ldl-unsada-tpi",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "sscarcelli-ops",
            "email": "sscarcelli@alumnos.unsada.edu.ar"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^3.5",
        "symfony/console": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/cache": "^7.4",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.1",
        "phpmailer/phpmailer": "^7.1",
        "symfony/var-exporter": "7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "scripts": {
        "test": "phpunit",
        "test:access": "phpunit --testsuite AccessControl",
        "test:alert": "phpunit --testsuite AlertManagement",
        "test:auth": "phpunit --testsuite Authentication",
        "test:credential": "phpunit --testsuite CredentialDisplay",
        "test:credential-mgmt": "phpunit --testsuite CredentialManagement",
        "test:messaging": "phpunit --testsuite Messaging",
        "test:password": "phpunit --testsuite PasswordRecovery",
        "test:sello": "phpunit --testsuite Sello",
        "test:user": "phpunit --testsuite UserManagement",
        "test:search": "phpunit --testsuite Search"
    }
}
