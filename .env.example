# ─── Configuración de la Base de Datos ───────────────────────────────────
# Doctrine soporta múltiples motores cambiando solo DB_DRIVER:
#   pdo_mysql   → MySQL / MariaDB
#   pdo_pgsql   → PostgreSQL
#   pdo_sqlite  → SQLite (archivo local)
#   pdo_sqlsrv  → SQL Server
#
# La base de datos se crea automáticamente al ejecutar la migration.
# ========================================================================
DB_DRIVER=pdo_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=credenciales_digitales
DB_USER=root
DB_PASS=

# ─── Configuración JWT ──────────────────────────────────────────────────
# JWT_SECRET:   Clave secreta para firmar los tokens. CAMBIAR en producción.
# JWT_EXPIRES:  Duración del access token en segundos (900 = 15 minutos)
# JWT_REFRESH_EXPIRES: Duración del refresh token en segundos (2592000 = 30 días)
# ========================================================================
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRES=900
JWT_REFRESH_EXPIRES=2592000

# ─── Base path de la aplicación ───
# Si la app está en un subdirectorio del servidor web, definir acá el prefijo
# para que el Router vea las rutas relativas correctas.
# Dejar vacío si el document root apunta directo a public/.
# APP_BASE_PATH=/icb/public

# ─── Credenciales para Swagger UI (HTTP Basic Auth) ─────────────────────
# Usuario y contraseña para acceder a la documentación interactiva de la API.
SWAGGER_USER=icbSw
SWAGGER_PASS=cambiar-en-produccion

# ─── Entorno de ejecución ───────────────────────────────────────────────
# APP_ENV=dev   → muestra token de recuperación, errores detallados
# APP_ENV=prod  → oculta información sensible
APP_ENV=dev

# ─── CORS ───────────────────────────────────────────────────────────────
# Origen permitido para CORS. Si no se define, solo mismo origen.
# En desarrollo: CORS_ORIGIN=* (o http://localhost:3000)
# En producción: CORS_ORIGIN=https://tudominio.com
# CORS_ORIGIN=*

# ─── Proxies confiables (para rate limiting) ───────────────────────────
# Lista separada por coma de IPs de proxies inversos (Cloudflare, AWS ALB, etc.)
# Si está vacío, solo se usa REMOTE_ADDR (más seguro).
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
