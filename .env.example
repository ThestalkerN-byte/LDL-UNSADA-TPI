# ───────────────────────────────────────────────
# CONFIGURACIÓN DE ENTORNO — LDL-UNSADA-TPI
# ───────────────────────────────────────────────
# Template público para configuración de entorno.
# Copiar a .env y completar con los valores reales.
#
# 1. cp .env.example .env
# 2. Editar .env con las credenciales correctas
# 3. ¡Nunca subir .env al repositorio!
# ───────────────────────────────────────────────

# --- Entorno ---
# development | production | testing
APP_ENV=development
# true muestra errores detallados; false los oculta
APP_DEBUG=true

# --- Base de Datos ---
# Driver PDO (pdo_mysql, pdo_pgsql, etc.)
DB_DRIVER=pdo_mysql
# Host del servidor de base de datos
DB_HOST=localhost
# Puerto de conexión
DB_PORT=3306
# Nombre de la base de datos
DB_NAME=defaultdb
# Usuario de base de datos
DB_USER=root
# Contraseña del usuario
DB_PASS=
# Juego de caracteres
DB_CHARSET=utf8mb4
# SSL: REQUIRED | PREFERRED | NONE
DB_SSL=REQUIRED

# --- JWT ---
# Clave secreta para firmar los tokens JWT. CAMBIAR en producción.
# Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-this-to-a-random-secret-key
# Duración del token en segundos (3600 = 1 hora, 900 = 15 min)
JWT_EXPIRY=3600

# --- CORS ---
# Origen permitido para CORS (Access-Control-Allow-Origin).
# "*" permite cualquier origen (útil en desarrollo).
# En producción, especificar el dominio exacto:
#   CORS_ORIGIN=https://app.midominio.com
# Déjalo vacío o comentalo para usar "*" por defecto.
CORS_ORIGIN=*
