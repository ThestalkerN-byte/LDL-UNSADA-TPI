{
    "name": "icb/credenciales-digitales",
    "description": "Sistema de Credenciales Digitales - Iglesia Cristiana Biblica",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^3",
        "doctrine/dbal": "^4",
        "doctrine/migrations": "^3",
        "firebase/php-jwt": "^6",
        "vlucas/phpdotenv": "^5",
        "symfony/console": "^7",
        "symfony/cache": "^8.1",
        "zircote/swagger-php": "^6.1"
    },
    "autoload": {
        "psr-4": {
            "ICB\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    }
}
